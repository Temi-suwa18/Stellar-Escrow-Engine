# ---------------------------------------------------------------------------
# Stellar-Escrow-Engine — environment configuration
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# --- Core ---
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000
# Read by the Next.js frontend at build/runtime — must be reachable from the browser.
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Database ---
DATABASE_URL=postgresql://stellar:stellar@localhost:5432/stellar_escrow?schema=public

# --- Redis / Queues ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_ACCESS_SECRET=change-me-to-a-random-64-char-secret
JWT_REFRESH_SECRET=change-me-to-a-different-random-64-char-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
SESSION_SECRET=change-me-session-secret

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:4000/auth/google/callback

GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:4000/auth/github/callback

MAGIC_LINK_TTL_MINUTES=15

# --- Email (magic links, invitations, invoices, reminders) ---
EMAIL_FROM="ESCRA <noreply@stellarescrow.dev>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Stellar / Soroban ---
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2022"
USDC_ASSET_ISSUER=

# --- Webhooks ---
WEBHOOK_SIGNING_SECRET=change-me-webhook-signing-secret

# --- Object storage (invoice PDFs, exports) ---
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Observability ---
LOG_LEVEL=info
SENTRY_DSN=
