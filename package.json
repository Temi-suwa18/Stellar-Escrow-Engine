{
  "name": "stellar-escrow-engine",
  "version": "0.1.0",
  "private": true,
  "description": "A universal escrow protocol on Stellar — freelance, ecommerce, rentals/vehicles, logistics, and milestone payments. Apps just call the API.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "db:generate": "pnpm --filter @stellar-commerce/database generate",
    "db:migrate": "pnpm --filter @stellar-commerce/database migrate:dev",
    "db:seed": "pnpm --filter @stellar-commerce/database seed",
    "db:studio": "pnpm --filter @stellar-commerce/database studio",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  }
}
