{
  "name": "@stellar-escrow/sdk",
  "version": "0.1.0",
  "description": "Official TypeScript/JavaScript client for the ESCRA escrow API.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Temi-suwa18/Stellar-Escrow-Engine",
    "directory": "sdks/typescript"
  },
  "keywords": ["escrow", "stellar", "soroban", "payments", "api-client"],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint \"{src,test}/**/*.ts\" --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "clean": "rm -rf dist coverage"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@stellar-escrow/config": "workspace:*",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^2.1.8"
  }
}
